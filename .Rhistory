library("tidyverse")
df <- data.frame(Label = c("hansard_YYYY", "debate_metadata_YYYY", "speaker_metadata_YYYY", "file_metadata_YYYY"),
Description = c("Hansard debate text",
"Metadata such as speech date and title.",
