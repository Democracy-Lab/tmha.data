})
# 2) compute top similar words per decade
out <- purrr::imap_dfr(embeddings_by_decade, function(mat, dec_name) {
df <- top_similar_words_one_decade(mat, search_word, top_n = top_n)
if (is.null(df)) return(NULL)
mutate(df, decade = as.integer(dec_name))
})
if (nrow(out) == 0) stop("Keyword not found in any decade’s vocabulary.")
# 3) plot
p <- plot_ly(
data = out,
x = ~decade,
y = ~similarity,
mode = "markers+text",
text = ~word,
type = "scatter",
textposition = "center right",
height = plot_height
) %>%
layout(
xaxis = list(
autotick = FALSE,
tickmode = "array",
tickvals = sort(unique(out$decade)),
dtick = 10,
range = c(min(out$decade) - 10, max(out$decade) + 10)
),
title = paste0('Words Most Associated with "', search_word, '" via Embeddings')
) %>%
config(displayModeBar = FALSE)
list(plot = p, data = out, embeddings = embeddings_by_decade)
}
# ---- example usage with YOUR objects ----
# (Assumes you already created climate_change_text_2000 / 2010 / 2020)
decade_texts <- list(
"2000" = climate_change_text_2000,
"2010" = climate_change_text_2010,
"2020" = climate_change_text_2020
)
res <- make_word_context_plot_from_texts("politic", decade_texts)
res$plot
# head(res$data)
# ---- your embedding function (unchanged, just returns a matrix) ----
find_word_embeddings <- function(data,
rank = 50,
window = 5L,
term_count_min = 1,
x_max = 10,
n_iter = 30,
seed = 42) {
tokens <- word_tokenizer(str_to_lower(data))
it <- itoken(tokens, ids = seq_along(tokens), progressbar = FALSE)
vocab <- create_vocabulary(it) %>%
prune_vocabulary(term_count_min = term_count_min)
vectorizer <- vocab_vectorizer(vocab)
tcm <- create_tcm(it, vectorizer, skip_grams_window = window)
set.seed(seed)
glove <- GlobalVectors$new(rank = rank, x_max = x_max)
wv_main <- glove$fit_transform(tcm, n_iter = n_iter)
wv_context <- glove$components
# final embedding matrix (words as rownames)
word_embeddings <- wv_main + t(wv_context)
word_embeddings
}
# ---- helper: top-N similar words in ONE embedding matrix ----
top_similar_words_one_decade <- function(word_vectors, search_word, top_n = 15) {
search_word <- tolower(search_word)
if (!search_word %in% rownames(word_vectors)) return(NULL)
kw <- word_vectors[search_word, , drop = FALSE]
cos_sim <- sim2(x = word_vectors, y = kw, method = "cosine", norm = "l2")[, 1]
cos_sim <- sort(cos_sim, decreasing = TRUE)
cos_sim <- cos_sim[names(cos_sim) != search_word] # drop the word itself
head_words <- head(cos_sim, top_n)
tibble(
word = names(head_words),
similarity = as.numeric(head_words)
)
}
# ---- main: build embeddings from your texts + plot ----
# INPUT: a named list where names are decades and values are the text for that decade
# e.g. list("2000" = climate_change_text_2000, "2010" = climate_change_text_2010, ...)
make_word_context_plot_from_texts <- function(search_word,
decade_texts,
top_n = 15,
rank = 50,
window = 5L,
term_count_min = 1,
x_max = 10,
n_iter = 30,
seed = 42,
plot_height = 650) {
decades <- as.integer(names(decade_texts))
if (any(is.na(decades))) stop("decade_texts must be a *named* list with numeric decade names, e.g. '2000', '2010'.")
# 1) build embeddings per decade (in-memory)
embeddings_by_decade <- lapply(decade_texts, function(txt) {
find_word_embeddings(
data = txt,
rank = rank,
window = window,
term_count_min = term_count_min,
x_max = x_max,
n_iter = n_iter,
seed = seed
)
})
# 2) compute top similar words per decade
out <- purrr::imap_dfr(embeddings_by_decade, function(mat, dec_name) {
df <- top_similar_words_one_decade(mat, search_word, top_n = top_n)
if (is.null(df)) return(NULL)
mutate(df, decade = as.integer(dec_name))
})
if (nrow(out) == 0) stop("Keyword not found in any decade’s vocabulary.")
# 3) plot
p <- plot_ly(
data = out,
x = ~decade,
y = ~similarity,
mode = "markers+text",
text = ~word,
type = "scatter",
textposition = "center right",
height = plot_height
) %>%
layout(
xaxis = list(
autotick = FALSE,
tickmode = "array",
tickvals = sort(unique(out$decade)),
dtick = 10,
range = c(min(out$decade) - 10, max(out$decade) + 10)
),
title = paste0('Words Most Associated with "', search_word, '" via Embeddings')
) %>%
config(displayModeBar = FALSE)
list(plot = p, data = out, embeddings = embeddings_by_decade)
}
# ---- example usage with YOUR objects ----
# (Assumes you already created climate_change_text_2000 / 2010 / 2020)
decade_texts <- list(
"2000" = climate_change_text_2000,
"2010" = climate_change_text_2010,
"2020" = climate_change_text_2020
)
res <- make_word_context_plot_from_texts("america", decade_texts)
res$plot
# head(res$data)
plot_neighbors_over_decades <- function(decade_texts, mode = c("similar","subtract"),
word1, word2 = NULL, top_n = 15) {
mode <- match.arg(mode)
out <- purrr::imap_dfr(decade_texts, function(txt, decade) {
W <- find_word_embeddings(txt)
df <- if (mode == "similar") {
get_similar(tolower(word1), W, top_n)
} else {
vector_subtraction(tolower(word1), tolower(word2), W, top_n)
}
mutate(df, decade = as.integer(decade))
})
title_txt <- if (mode == "similar") {
paste0('Words Most Associated with "', word1, '"')
} else {
paste0('Words Associated with "', word1, '" not "', word2, '" (', word1, " - ", word2, ")")
}
plot_ly(out,
x = ~decade, y = ~similarity,
text = ~word, type = "scatter",
mode = "markers+text",
textposition = "center right",
height = 650) %>%
layout(title = title_txt,
xaxis = list(tickmode = "array",
tickvals = sort(unique(out$decade))))
}
# examples
decade_texts <- list("2000" = climate_change_text_2000,
"2010" = climate_change_text_2010,
"2020" = climate_change_text_2020)
plot_neighbors_over_decades(decade_texts, "similar",  "america", top_n = 15)
plot_neighbors_over_decades(decade_texts, "subtract", "america", "empire", top_n = 15)
